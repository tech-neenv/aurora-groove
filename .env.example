# Copy to .env.local and fill from Supabase → Project Settings → API.
# The anon/public key is safe in client code. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# PostHog analytics — from PostHog → Project settings → Project API key.
# The project API key (phc_...) is safe in client code. Host: us.i.posthog.com
# (US cloud) or eu.i.posthog.com (EU cloud). Leave blank to disable analytics.
VITE_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
